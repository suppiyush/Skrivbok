# ───────────────────────────── Environment ──────────────────────────────
# NEVER commit real secrets. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# ───────────────────────────── Build output ─────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ───────────────────────────── Prisma ───────────────────────────────────
# Migrations ARE committed. Generated client is not.
apps/server/prisma/generated/
prisma/generated/
apps/server/src/generated/

# ───────────────────────────── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────────────────────────── Testing ──────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.vitest/

# ───────────────────────────── Caches ───────────────────────────────────
.cache/
.eslintcache
.parcel-cache/
.vite/
.rollup.cache/

