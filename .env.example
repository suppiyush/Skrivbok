# ==============================================================================
#  SKRIVBOK — Environment Template
# ==============================================================================
#  Copy to `.env` and fill in real values.  NEVER commit `.env`.
#
#      cp .env.example .env
#
#  Every variable here is validated by `src/config/env.ts` (Zod) at boot.
#  A missing or malformed required value crashes the process immediately
#  instead of failing silently at runtime.
# ==============================================================================


# ─────────────────────────────── Runtime ──────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=4000
# Public origin of the API itself (used to build OAuth callback + email links)
API_URL=http://localhost:4000
# Public origin of the web app (used for CORS, OAuth redirect, email links)
WEB_URL=http://localhost:5173
# Comma-separated CORS allowlist. Must include WEB_URL.
# In development include BOTH localhost and 127.0.0.1: the dev server binds
# every interface, and a browser opened on one origin is refused by the other.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug


# ─────────────────────────────── Database ─────────────────────────────────────
# Prisma connection string. Use a DEDICATED database — never reuse the legacy one.
DATABASE_URL=postgresql://skrivbok:change_me@localhost:5432/skrivbok?schema=public
# Direct (non-pooled) connection. Required by `prisma migrate` when DATABASE_URL
# points at a pgbouncer/Neon/Supabase pooler. Set equal to DATABASE_URL locally.
DIRECT_URL=postgresql://skrivbok:change_me@localhost:5432/skrivbok?schema=public


# ─────────────────────────────── Sessions ─────────────────────────────────────
# 32+ random bytes. Generate with:  openssl rand -base64 48
SESSION_SECRET=replace_me_with_openssl_rand_base64_48
# Session lifetime in days (sliding window; refreshed on activity)
SESSION_TTL_DAYS=30
# Cookie name for the opaque session token
SESSION_COOKIE_NAME=skrivbok_sid
# Cookie domain — leave blank for localhost, set to `.yourdomain.com` in prod
COOKIE_DOMAIN=


# ─────────────────────────────── Google OAuth ─────────────────────────────────
# REQUIRED. Google is the only sign-in method, so without these nobody can sign
# in — the app still boots, and the login page says so instead of offering a
# button that cannot work.
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback


# ─────────────────────────────── Email ────────────────────────────────────────
# Leave both BREVO_API_KEY and SMTP_HOST blank to disable outbound mail
# (sends are logged instead of delivered).
#
# Preferred: a Brevo API key (Brevo → SMTP & API → API Keys). Mail then goes
# out over HTTPS, which works on hosts that block SMTP ports (Render's free
# tier, for one). Note this is the *API* key, not the SMTP key.
BREVO_API_KEY=
# Or any SMTP server. Ignored when BREVO_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Skrivbok
MAIL_FROM_ADDRESS=no-reply@skrivbok.app
# Where "Contact us" / bug reports are delivered
SUPPORT_EMAIL=support@skrivbok.app


# ──────────────────────── Image uploads (Cloudinary) ──────────────────────────
# Optional. Leave blank to disable photo uploads — the profile screen then says
# so instead of offering a button that fails. Images go straight from the
# browser to Cloudinary with a short-lived signature; they never pass through
# this server, so the 1MB JSON body limit does not apply to them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ─────────────────────────────── Reminder worker ──────────────────────────────
# Set false on the API process when the worker runs as a separate container.
ENABLE_REMINDER_WORKER=true
# Cron expression — how often the worker scans for due reminders.
REMINDER_CRON=*/5 * * * *
# IANA timezone the cron expression is evaluated in.
REMINDER_CRON_TZ=UTC


# ─────────────────────────────── Razorpay (billing) ───────────────────────────
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Leave RAZORPAY_KEY_ID blank to disable billing (PRO upgrade returns 503).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret — set when creating the webhook in the Razorpay dashboard.
# Endpoint: POST {API_URL}/api/v1/billing/webhook
RAZORPAY_WEBHOOK_SECRET=
# Plan prices in the smallest currency unit (paise). Server-side source of truth —
# the client never sends an amount.
PRICE_MONTHLY_PAISE=49900
PRICE_YEARLY_PAISE=499900
BILLING_CURRENCY=INR


# ─────────────────────────────── Free-tier limits ─────────────────────────────
# Per-resource caps for non-PRO accounts. -1 means unlimited.
FREE_LIMIT_PROJECTS=5
FREE_LIMIT_CAREER_GOALS=5
FREE_LIMIT_LITERATURE=5


# ─────────────────────────────── Admin bootstrap ──────────────────────────────
# Used ONCE by `pnpm db:seed` to create the first admin user, then ignored.
# There is no password: sign-in is Google-only, so this is the Google address
# that receives the ADMIN role when it first signs in. Use one you control.
# Without it, no admin account is created.
ADMIN_EMAIL=


# ─────────────────────────────── Rate limiting ────────────────────────────────
# Window in minutes and max requests per window, per IP.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
# Stricter bucket for the Google sign-in entry point, /auth/google
AUTH_RATE_LIMIT_MAX=10
